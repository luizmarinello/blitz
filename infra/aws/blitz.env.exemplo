# Modelo de /etc/blitz/blitz.env  (R06, R09). NUNCA versionar o arquivo real.
# O instalar.sh gera o arquivo real com senha e segredo aleatórios.

# Back-end só na interface local: o acesso externo passa pelo Nginx
SERVER_ADDRESS=127.0.0.1
PORT=8080

# PostgreSQL local na própria EC2
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/blitz
DATABASE_USER=blitz
DATABASE_PASSWORD=VALOR_OCULTADO

# Front e API na mesma origem: FRONT_URL vazio (sem CORS) e cookie Strict
FRONT_URL=
COOKIE_SAMESITE=strict
COOKIE_SECURE=false            # true depois que o HTTPS estiver ativo

# Endereço público (links de e-mail da recuperação de senha)
APP_URL=http://IP_OU_DOMINIO
APP_SECRET=VALOR_OCULTADO

# Conta que vira administrador (RN04)
ADMIN_EMAIL=VALOR_OCULTADO

# IA: sem chave, o assistente local responde (RF17)
GEMINI_API_KEY=VALOR_OCULTADO     # vazio = assistente local; chave do Google AI Studio (plano gratuito)
GEMINI_MODELO=gemini-3.5-flash-lite
IA_PSEUDONIMO_SAL=VALOR_OCULTADO
